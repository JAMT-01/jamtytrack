{
  // PARTIAL CONFIG — D1 operations only.
  //
  // This intentionally omits `main` and `assets`. The deployed Worker is
  // currently the ONLY copy of the source code (see jamtytrack-kb.md §9), so a
  // config complete enough to run `wrangler deploy` from could overwrite the
  // live Worker with an empty or assets-only build and destroy it.
  //
  // Leaving those keys out makes `wrangler deploy` fail fast instead.
  // Restore them from jamtytrack-kb.md §2 once the source has been recovered
  // and committed to git.
  "name": "jamtytrack",
  "compatibility_date": "2026-08-13",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "jamtytrack",
      "database_id": "4fa3290f-cf68-410a-840e-8fb3a22561c2",
      "migrations_dir": "migrations"
    }
  ]
}
